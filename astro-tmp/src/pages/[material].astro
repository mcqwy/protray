---
import MaterialPage from '../components/MaterialPage.astro';
import materials from '../data/materials.json';

export function getStaticPaths() {
  return materials.map((m) => ({ params: { material: m.slug }, props: { material: m } }));
}

const { material } = Astro.props;
---
<MaterialPage lang="en" basePath="/protray" material={material} />