---
import '../styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Seo from './Seo.astro';
import ui from '../data/ui-translations.json';

const { lang, basePath, material } = Astro.props;
const t = ui[lang];
const mt = material.translations[lang];
const currentPath = material.slug;

const homeUrl = lang === 'en' ? '/protray/' : `/protray/${lang}/`;

const waLink = `https://wa.me/8615864555803?text=${encodeURIComponent(
  `Hello ProTrays, I'm interested in ${material.material} seedling trays. Page: ${Astro.url.href}`
)}`;

const heroImgAlt = `${material.shortName} commercial seedling tray 540x280mm for high-speed automated seeding lines`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": mt.heroTitle,
  "image": [
    "https://mcqwy.github.io/protray/assets/images/tray-32.jpg",
    "https://mcqwy.github.io/protray/assets/images/tray-50.jpg",
    "https://mcqwy.github.io/protray/assets/images/tray-128.jpg"
  ],
  "description": mt.description,
  "brand": { "@type": "Brand", "name": "ProTrays" },
  "material": material.material,
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Hole Count", "value": "32, 40, 50, 72, 98, 105, 128" },
    { "@type": "PropertyValue", "name": "Dimensions", "value": "540mm × 280mm" },
    { "@type": "PropertyValue", "name": "Weight per Tray", "value": "60g / 70g / 80g / 90g / 100g" },
    { "@type": "PropertyValue", "name": "Material Thickness", "value": "0.4mm / 0.5mm / 0.6mm / 0.7mm" },
    { "@type": "PropertyValue", "name": "Cell Depth", "value": "4.0cm - 5.5cm" },
    { "@type": "PropertyValue", "name": "Packaging", "value": "Bundled or Carton Packaging" },
    { "@type": "PropertyValue", "name": "MOQ", "value": "5,000 pieces" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": mt.faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="FciYTy6rVndujVljzY2LvS7oreEc7Vx3_zwuI_x1UzM" />
  <title>{mt.title}</title>
  <meta name="description" content={mt.description} />

  <Seo lang={lang} currentPath={material.slug} />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6W7G7ZQY7Z"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-6W7G7ZQY7Z');</script>
  <script is:inline type="text/javascript">(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","yxpj0e4iqt");</script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
<Nav lang={lang} currentPath={currentPath} />

<section class="pt-36 pb-16 md:pt-32 md:pb-24 bg-gradient-to-r from-green-700 to-green-900 text-white overflow-x-hidden">
  <div class="max-w-[90rem] mx-auto px-4 md:px-8 flex flex-col md:flex-row items-center gap-8 md:gap-12">
    <div class="w-full md:w-1/2 text-center md:text-left">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 leading-tight">{mt.heroTitle}</h1>
      <p class="text-lg sm:text-xl mb-6 text-green-100">{mt.heroSubtitle}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <button id="reqSampleBtn" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-3 px-6 rounded-lg text-sm sm:text-base shadow-lg transition">{t.hero.cta}</button>
        <a href={waLink} class="bg-transparent border-2 border-white hover:bg-white hover:text-green-700 text-white font-bold py-3 px-6 rounded-lg text-sm sm:text-base transition inline-block text-center" target="_blank" rel="noopener noreferrer">{t.hero.salesCta}</a>
      </div>
    </div>
    <div class="w-full md:w-1/2">
      <div class="relative rounded-xl overflow-hidden shadow-lg bg-gray-100 flex items-center justify-center min-h-[400px]">
        <img src="/protray/assets/images/tray-128.jpg" alt={heroImgAlt} class="w-full h-auto object-contain max-h-[500px]" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-white overflow-x-hidden">
  <div class="max-w-[90rem] mx-auto px-4 md:px-8">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">{mt.whyChooseTitle}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {mt.advantages.map(adv => (
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
          <h3 class="text-lg font-bold mb-3 text-gray-800">{adv.title}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{adv.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-16 bg-gray-50 overflow-x-hidden">
  <div class="max-w-[90rem] mx-auto px-4 md:px-8">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">{t.specs.quickSpecsTitle}</h2>

    <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-md border border-gray-100 p-6 sm:p-8">
      <p class="text-center text-gray-700 mb-3">
        <span class="font-bold text-gray-800">{t.specs.summaryPrefix}: </span>
        32-128 Holes · 540×280mm · 60-100g · Depth 4.0-5.5cm
      </p>
      <p class="text-center text-gray-500 text-sm mb-6">
        {t.specs.moq} · {t.specs.deliveryTerms}
      </p>

      <details class="group border-t border-gray-100 pt-4">
        <summary class="cursor-pointer list-none flex justify-between items-center text-green-600 font-bold py-2 hover:text-green-700 transition select-none">
          <span>{t.specs.viewFullSpecs}</span>
          <i class="fas fa-chevron-down group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm lg:text-base">
            <tbody>
              <tr class="border-b border-gray-100">
                <td class="py-3 font-semibold text-gray-600 w-1/3">{t.specs.cellCount}</td>
                <td class="py-3 text-gray-800">32 / 40 / 50 / 72 / 98 / 105 / 128</td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-3 font-semibold text-gray-600">{t.specs.dimensions}</td>
                <td class="py-3 text-gray-800">540mm × 280mm</td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-3 font-semibold text-gray-600">{t.specs.material}</td>
                <td class="py-3 text-gray-800">{material.material}</td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-3 font-semibold text-gray-600">{t.specs.weight}</td>
                <td class="py-3 text-gray-800">60g / 70g / 80g / 90g / 100g</td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-3 font-semibold text-gray-600">{t.specs.thickness}</td>
                <td class="py-3 text-gray-800">0.4mm / 0.5mm / 0.6mm / 0.7mm</td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-3 font-semibold text-gray-600">{t.specs.cellDepth}</td>
                <td class="py-3 text-gray-800">4.0 cm - 5.5 cm</td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-3 font-semibold text-gray-600">{t.specs.packaging}</td>
                <td class="py-3 text-gray-800">{t.specs.packagingOptions}</td>
              </tr>
            </tbody>
          </table>
          <div class="mt-6 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded-r-lg">
            <p class="font-bold text-base text-gray-800">{t.specs.moq}</p>
            <p class="text-gray-600 text-sm mt-1">{t.specs.deliveryTerms}</p>
          </div>
          <div class="mt-4 p-3 bg-blue-50 border-l-4 border-blue-400 rounded-r-lg text-sm text-gray-700">{t.specs.customNotification}</div>
        </div>
      </details>

      <div class="border-t border-gray-100 pt-4 mt-4 text-center">
        <a href={homeUrl} class="inline-flex items-center text-green-600 font-bold hover:text-green-700 transition">
          {t.specs.viewAllSeries}
        </a>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-white overflow-x-hidden">
  <div class="max-w-[90rem] mx-auto px-4 md:px-8">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">{t.faq.title}</h2>
    <div class="max-w-4xl mx-auto space-y-4">
      {mt.faq.map(f => (
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <button class="faq-question w-full text-left px-6 py-5 font-bold text-gray-800 flex justify-between items-center hover:bg-gray-50 focus:outline-none">
            <span>{f.q}</span><i class="fas fa-chevron-down text-gray-500"></i>
          </button>
          <div class="faq-answer hidden px-6 pb-5 text-gray-600 text-sm sm:text-base bg-gray-50/50"><p>{f.a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="contactFormSection" class="py-16 bg-gray-50 overflow-x-hidden">
  <div class="max-w-[90rem] mx-auto px-4 md:px-8">
    <div class="bg-white rounded-2xl shadow-lg max-w-4xl mx-auto p-6 sm:p-10">
      <h3 class="text-2xl font-bold text-center mb-8 text-gray-800">{t.form.title}</h3>
      <form id="leadContactForm" action="https://formcarry.com/s/MaZrhfPopVM" method="POST" class="space-y-5">
        <div style="display:none;"><input type="text" name="website_url" tabindex="-1" autocomplete="off"></div>
        <input type="hidden" name="material" value={material.shortName} />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div><label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.name}</label><input type="text" name="name" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required></div>
          <div><label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.company}</label><input type="text" name="company" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div><label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.email}</label><input type="email" name="email" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required></div>
          <div><label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.phone}</label><input type="tel" name="phone" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required></div>
        </div>
        <div>
          <label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.country}</label>
          <select name="country" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
            {t.form.countryOptions.map(opt => (
              <option value={opt.value} disabled={opt.value === ''} selected={opt.value === ''}>{opt.label}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.product}</label>
          <select name="product" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
            {t.form.productOptions.map(opt => (
              <option value={opt.value} disabled={opt.value === ''} selected={opt.value === ''}>{opt.label}</option>
            ))}
          </select>
        </div>
        <div><label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.quantity}</label><input type="number" name="quantity" min="5000" step="1000" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required></div>
        <div><label class="block text-gray-700 mb-1.5 text-sm font-medium">{t.form.message}</label><textarea name="message" rows="4" class="w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-green-500 outline-none"></textarea></div>
        <div class="text-center pt-2"><button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-10 rounded-xl shadow-md transition">{t.form.submit}</button></div>
      </form>
      <div id="formSuccessMessage" class="hidden text-center text-green-700 font-bold text-base sm:text-lg mt-6"></div>
    </div>
  </div>
</section>

<Footer lang={lang} />

<div id="whatsappBubble" class="whatsapp-bubble hidden">
  <span>{t.whatsapp.bubble}</span>
  <button id="closeBubble" class="ml-2 text-gray-400 hover:text-white">&times;</button>
</div>
<a href={waLink} class="whatsapp-float" target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp"></i></a>

<script is:inline>
  window.__FORM_SUCCESS__ = "Thank you! Our team will contact you within 24 hours.";
</script>
<script is:inline src="/protray/js/main.js"></script>
</body>
</html>